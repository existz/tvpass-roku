<?xml version="1.0" encoding="utf-8" ?>
<component name="SlideChannelMenuItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SlideChannelMenuItem.brs" />
    <!-- Shared enums -->
    <script type="text/brightscript" uri="pkg:/source/enums/ColorPalette.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChanged" />
        <field id="isSelected" type="boolean" />
    </interface>

    <children>
        <!-- Background -->
        <Rectangle
            id="background"
            translation="[0,0]"
            width="880"
            height="120"
            color="0x2A2A2AFF"/>

        <!-- Channel Logo -->
        <Poster
            id="logo"
            translation="[20,15]"
            loadWidth="80"
            loadHeight="70"
            width="80"
            height="70"
            loadDisplayMode="scaleToFit"
            failedBitmapUri=""/>

        <!-- Channel Number -->
        <Label
            id="channelNumber"
            translation="[110,30]"
            width="100"
            height="40"
            horizAlign="right"
            vertAlign="center"
            font="font:MediumBoldSystemFont"
            color="0xCCCCCCFF"/>

        <!-- Program Title (Now Playing) -->
        <Label
            id="programTitle"
            translation="[240,20]"
            width="600"
            height="35"
            horizAlign="left"
            vertAlign="center"
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF"
            wrap="false"/>

        <!-- Program Details (Episode/Description) -->
        <Label
            id="programDetails"
            translation="[240,70]"
            width="600"
            height="30"
            horizAlign="left"
            vertAlign="center"
            font="font:SmallSystemFont"
            color="0x888888FF"
            wrap="false"/>

        <!-- Selection Indicator for Multiview -->
        <Rectangle
            id="selectionIndicator"
            translation="[860,10]"
            width="10"
            height="100"
            color="0x00FF00FF"/>
    </children>
</component>