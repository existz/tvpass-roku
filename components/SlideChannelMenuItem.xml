<?xml version="1.0" encoding="utf-8" ?>
<component name="SlideChannelMenuItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SlideChannelMenuItem.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChanged" />
    </interface>

    <children>
        <!-- Background -->
        <Rectangle
            id="background"
            translation="[0,0]"
            width="780"
            height="120"
            color="0x2A2A2AFF"/>

        <!-- Channel Logo -->
        <Poster
            id="logo"
            translation="[20,15]"
            width="80"
            height="70"
            loadDisplayMode="scaleToFit"
            failedBitmapUri=""/>

        <!-- Channel Number -->
        <Label
            id="channelNumber"
            translation="[125,30]"
            width="60"
            height="40"
            horizAlign="center"
            vertAlign="center"
            font="font:MediumBoldSystemFont"
            color="0xCCCCCCFF"/>

        <!-- Program Title (Now Playing) -->
        <Label
            id="programTitle"
            translation="[210,20]"
            width="550"
            height="35"
            horizAlign="left"
            vertAlign="center"
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF"
            wrap="false"/>

        <!-- Program Details (Episode/Description) -->
        <Label
            id="programDetails"
            translation="[210,70]"
            width="550"
            height="30"
            horizAlign="left"
            vertAlign="center"
            font="font:SmallSystemFont"
            color="0x888888FF"
            wrap="false"/>
    </children>
</component>