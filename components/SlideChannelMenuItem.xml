<?xml version="1.0" encoding="utf-8" ?>
<component name="SlideChannelMenuItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SlideChannelMenuItem.brs" />
    <!-- Shared enums -->
    <script type="text/brightscript" uri="pkg:/source/enums/ColorPalette.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChanged" />
        <field id="isSelected" type="boolean" />
    </interface>

    <children>
        <!-- Background -->
        <Rectangle
            id="background"
            translation="[0,0]"
            width="880"
            height="135"
            color="0x2A2A2AFF"/>

        <!-- Channel Logo -->
        <Poster
            id="logo"
            translation="[27,22]"
            loadWidth="76"
            loadHeight="76"
            width="76"
            height="76"
            loadDisplayMode="scaleToFit"
            failedBitmapUri=""/>

        <!-- Channel Number -->
        <Label
            id="channelNumber"
            translation="[120,35]"
            width="120"
            height="50"
            horizAlign="right"
            vertAlign="center"
            font="font:SmallBoldSystemFont"
            color="0xCCCCCCFF"/>

        <!-- Program Title (Now Playing) - Centered -->
        <Label
            id="programTitle"
            translation="[260,40]"
            width="600"
            height="50"
            horizAlign="left"
            vertAlign="center"
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF"
            wrap="false"/>

        <!-- Selection Indicator for Multiview -->
        <Rectangle
            id="selectionIndicator"
            translation="[860,30]"
            width="10"
            height="112"
            color="0x00FF00FF"/>
    </children>
</component>