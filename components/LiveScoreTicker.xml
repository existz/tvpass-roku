<?xml version="1.0" encoding="utf-8" ?>
<component name="LiveScoreTicker" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/LiveScoreTicker.brs" />
    <script type="text/brightscript" uri="pkg:/source/enums/ColorPalette.brs" />
    <script type="text/brightscript" uri="pkg:/source/enums/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/source/enums/URLs.brs" />

    <interface>
        <field id="visible" type="boolean" />
        <field id="apiKey" type="string" />
    </interface>

    <children>
        <!-- Ticker background bar -->
        <Rectangle
            id="tickerBackground"
            translation="[0,0]"
            width="1540"
            height="60"
            color="0x000000FF"
            opacity="0.85"/>

        <!-- Scrolling container now spans full width -->
        <Group
            id="scrollContainer"
            translation="[0,0]"
            clippingRect="[0, 0, 1540, 60]"
            visible="true">

            <!-- Inner content group that actually scrolls -->
            <Group
                id="contentGroup"
                translation="[0,0]"/>
        </Group>
    </children>
</component>