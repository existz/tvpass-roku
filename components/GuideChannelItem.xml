<?xml version="1.0" encoding="utf-8" ?>
<component name="GuideChannelItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/GuideChannelItem.brs" />
    <!-- Shared enums -->
    <script type="text/brightscript" uri="pkg:/source/enums/ColorPalette.brs" />
    <script type="text/brightscript" uri="pkg:/source/enums/Utils.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChanged" />
        <field id="width" type="float" onChange="onWidthChanged" />
    </interface>

    <children>
        <!-- Background -->
        <Rectangle
            id="background"
            translation="[0,0]"
            width="1800"
            height="115"
            color="0x1A1A1AFF"/>

        <!-- Channel Logo -->
        <Poster
            id="channelLogo"
            translation="[15,28]"
            loadWidth="76"
            loadHeight="76"
            width="76"
            height="76"
            loadDisplayMode="scaleToFit"
            failedBitmapUri=""
            visible="false"/>

        <!-- Channel Number -->
        <Label
            id="channelNumber"
            translation="[150,43]"
            width="130"
            height="30"
            horizAlign="center"
            vertAlign="center"
            font="font:SmallBoldSystemFont"
            color="0xFFFFFFFF"
            wrap="false"/>

        <!-- Program Slots Container -->
        <Group
            id="programSlots"
            translation="[340,0]"/>
    </children>
</component>