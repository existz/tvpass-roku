<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs"/>

  <children>
    <!-- Loading / Error Label -->
    <Label id="loadingLabel"
           text="Loading Channels..."
           translation="[540,300]"
           width="840"
           height="60"
           horizAlign="center"
           vertAlign="center"
           font="font:LargeBoldSystemFont"
           color="0xFFFFFFFF"/>

    <!-- VERTICAL LIST using MarkupList -->
    <MarkupList
        id="channelList"
        visible="false"
        translation="[100,100]"
        itemComponentName="SimpleChannelItem"
        itemSize="[1720,70]"
        itemSpacing="[0,15]"
        drawFocusFeedback="false" />

    <!-- Video Player -->
    <Video
        id="videoPlayer"
        visible="false"
        translation="[0,0]"
        width="1920"
        height="1080"/>
  </children>
</component>
