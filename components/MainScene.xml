<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs"/>
  <!-- Shared enums -->
  <script type="text/brightscript" uri="pkg:/source/enums/ColorPalette.brs" />
  <script type="text/brightscript" uri="pkg:/source/enums/URLs.brs" />
  <script type="text/brightscript" uri="pkg:/source/enums/TeamCodes.brs" />
  <script type="text/brightscript" uri="pkg:/source/enums/Utils.brs" />

  <children>
    <!-- Video Player (bottom layer) -->
    <Video
        id="videoPlayer"
        visible="false"
        translation="[0,0]"
        width="1920"
        height="1080"
        opacity="1.0"/>

    <!-- Video Info Overlay -->
    <VideoInfoOverlay
        id="videoInfoOverlay"
        translation="[0,0]"/>

    <!-- Multiview Grid -->
    <MultiviewGrid
        id="multiviewGrid"
        visible="false"
        translation="[0,0]"/>

    <!-- Black overlay for dimming video -->
    <Rectangle
        id="videoOverlay"
        visible="false"
        translation="[0,0]"
        width="1920"
        height="1080"
        color="0x000000"
        opacity="0.9"/>

    <!-- Main Guide Container -->
    <Rectangle
        id="guideBackground"
        visible="false"
        translation="[0,0]"
        width="1920"
        height="1080"
        color="0x0F0F0FFF"/>

    <!-- Header Section -->
    <Rectangle
        id="headerBackground"
        visible="false"
        translation="[0,0]"
        width="1920"
        height="200"
        color="0x1A1A1AFF"/>

    <!-- Featured Program Info -->
    <Poster
        id="featuredLogo"
        visible="false"
        translation="[60,40]"
        loadWidth="300"
        loadHeight="150"
        width="300"
        height="150"
        loadDisplayMode="scaleToFit"/>

    <Label
        id="featuredTitle"
        visible="false"
        translation="[400,60]"
        width="800"
        height="50"
        font="font:LargeBoldSystemFont"
        color="0xFFFFFFFF"/>

    <Label
        id="featuredTime"
        visible="false"
        translation="[400,120]"
        width="400"
        height="35"
        font="font:MediumSystemFont"
        color="0xCCCCCCFF"/>

    <Label
        id="featuredDescription"
        visible="false"
        translation="[400,160]"
        width="1000"
        height="30"
        font="font:SmallSystemFont"
        color="0x888888FF"/>

    <!-- Current Time Display -->
    <Label
        id="currentTimeLabel"
        visible="false"
        translation="[1550,60]"
        width="300"
        height="50"
        horizAlign="right"
        font="font:LargeBoldSystemFont"
        color="0xFFFFFFFF"/>

    <!-- Guide Header -->
    <Label
        id="guideHeaderLabel"
        visible="false"
        translation="[60,220]"
        width="150"
        height="40"
        text="Guide"
        font="font:MediumBoldSystemFont"
        color="0xFFFFFFFF"/>

    <Label
        id="allChannelsLabel"
        visible="false"
        translation="[60,260]"
        width="200"
        height="30"
        text="All Channels"
        font="font:SmallSystemFont"
        color="0x777777FF"/>

    <!-- Time Slot Headers -->
    <LayoutGroup
        id="timeSlotHeaders"
        visible="false"
        translation="[310,230]"
        layoutDirection="horiz"
        itemSpacings="[0]"/>

    <!-- Channel Grid -->
    <MarkupList
        id="channelList"
        visible="false"
        translation="[60,310]"
        itemComponentName="GuideChannelItem"
        itemSize="[1800,80]"
        itemSpacing="[0,2]"
        drawFocusFeedback="false"/>

    <!-- Loading / Error Label -->
    <Label
        id="loadingLabel"
        text="Loading TV Guide..."
        translation="[540,500]"
        width="840"
        height="60"
        horizAlign="center"
        vertAlign="center"
        font="font:LargeBoldSystemFont"
        color="0xFFFFFFFF"/>

    <!-- Channel Menu (right side) -->
    <SlideChannelMenu
        id="channelMenu"
        visible="false"
        translation="[0,0]"/>
  </children>
</component>