<?xml version="1.0" encoding="utf-8" ?>
<component name="MultiviewGrid" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/MultiviewGrid.brs" />
    <!-- Shared enums -->
    <script type="text/brightscript" uri="pkg:/source/enums/ColorPalette.brs" />
    <script type="text/brightscript" uri="pkg:/source/enums/URLs.brs" />
    <script type="text/brightscript" uri="pkg:/source/enums/TeamCodes.brs" />

    <interface>
        <field id="channels" type="array" />
        <field id="originalVideoPlayer" type="node" />
        <field id="wasPlayingBeforeMultiview" type="boolean" />
        <field id="shouldRestoreVideo" type="boolean" />
        <field id="switchToChannelIndex" type="integer" alwaysNotify="true" />
    </interface>

    <children>
        <!-- Main Channel Label - only covers top strip -->
        <Rectangle
            id="labelBackground"
            translation="[0,0]"
            width="1540"
            height="60"
            color="0x000000CC"
            opacity="0.8"
            visible="true"/>
        
        <Label
            id="mainChannelLabel"
            translation="[20,10]"
            width="1500"
            height="40"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            horizAlign="left"
            vertAlign="center"
            visible="true"/>

        <!-- Thumbnail Container (right side) - Wider for better visibility -->
        <Rectangle
            id="thumbnailBackground"
            translation="[1540,0]"
            width="380"
            height="1080"
            color="0x000000CC"
            opacity="0.95"
            visible="true"/>
        
        <Group 
            id="thumbnailContainer"
            translation="[1540,60]"
            visible="true"/>

        <!-- Instructions -->
        <Rectangle
            translation="[1540,0]"
            width="380"
            height="60"
            color="0x0078D4FF"/>
        
        <Label
            translation="[1550,10]"
            width="360"
            height="40"
            text="MULTIVIEW MODE"
            font="font:MediumBoldSystemFont"
            color="0xFFFFFFFF"
            horizAlign="center"
            vertAlign="center"/>
        
        <Rectangle
            translation="[1540,1000]"
            width="380"
            height="80"
            color="0x000000CC"/>
        
        <Label
            translation="[1550,1010]"
            width="360"
            height="60"
            text="↑↓ Select  OK/→ Swap"
            font="font:SmallSystemFont"
            color="0xCCCCCCFF"
            horizAlign="center"
            vertAlign="center"
            wrap="true"/>
    </children>
</component>