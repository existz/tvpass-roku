<?xml version="1.0" encoding="utf-8" ?>
<component name="SimpleChannelItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SimpleChannelItem.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChanged" />
        <field id="width" type="float" onChange="onWidthChanged" />
    </interface>

    <children>
        <!-- Background -->
        <Rectangle
            id="background"
            translation="[0,0]"
            width="1720"
            height="55"
            color="0x000000FF"/>

        <!-- Channel Label -->
        <Label
            id="channelLabel"
            translation="[20,5]"
            width="1680"
            height="50"
            horizAlign="left"
            vertAlign="center"
            font="font:MediumSystemFont"
            color="0xDDDDDDFF"/>
    </children>
</component>
