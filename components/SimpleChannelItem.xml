<?xml version="1.0" encoding="utf-8" ?>
<component name="SimpleChannelItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SimpleChannelItem.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusPercentChanged" />
        <field id="width" type="float" onChange="onWidthChanged" />
    </interface>

    <children>
        <!-- Background -->
        <Rectangle
            id="background"
            translation="[0,0]"
            width="1720"
            height="60"
            color="0x000000FF"/>

        <!-- Channel Label -->
        <Label
            id="channelLabel"
            translation="[20,21]"
            width="950"
            height="28"
            horizAlign="left"
            vertAlign="center"
            font="font:MediumSystemFont"
            color="0xFFFFFFFF"/>

        <!-- Now Playing Label -->
        <Label
            id="nowPlayingLabel"
            translation="[990,21]"
            width="710"
            height="28"
            horizAlign="left"
            vertAlign="center"
            font="font:SmallSystemFont"
            color="0x999999FF"/>
    </children>
</component>
