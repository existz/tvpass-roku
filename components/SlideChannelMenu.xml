<?xml version="1.0" encoding="utf-8" ?>
<component name="SlideChannelMenu" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SlideChannelMenu.brs" />
    <!-- Shared enums -->
    <script type="text/brightscript" uri="pkg:/source/enums/TeamCodes.brs" />
    <script type="text/brightscript" uri="pkg:/source/enums/URLs.brs" />
    <script type="text/brightscript" uri="pkg:/source/enums/Utils.brs" />

    <interface>
        <field id="channels" type="array" onChange="onChannelsChanged" />
        <field id="currentChannelIndex" type="integer" />
        <field id="initialChannelIndex" type="integer" />
        <field id="selectedChannel" type="integer" alwaysNotify="true" />
        <field id="launchMultiview" type="array" alwaysNotify="true" />
        <field id="menuClosed" type="boolean" alwaysNotify="true" />
        <field id="epgData" type="assocarray" />
    </interface>

    <!-- Make the menu focusable so it can receive key events -->
    <children focusable="true">
        <!-- Hidden container for preloading sports logos -->
        <Group
            id="preloadContainer"
            translation="[-2000,-2000]"
            visible="false"/>

        <!-- Semi-transparent background overlay -->
        <Rectangle
            id="overlay"
            translation="[0,0]"
            width="1920"
            height="1080"
            color="0x000000"
            opacity="0.7"/>

        <!-- Menu container -->
        <Rectangle
            id="menuBackground"
            translation="[1040,0]"
            width="880"
            height="1080"
            color="0x1A1A1AFF"/>

        <!-- Menu header -->
        <Label
            id="menuTitle"
            translation="[1110,40]"
            width="780"
            height="60"
            text="Channels"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            horizAlign="left"
            vertAlign="center"/>

        <!-- Channel list -->
        <MarkupList
            id="channelList"
            translation="[1110,120]"
            itemComponentName="SlideChannelMenuItem"
            itemSize="[780,120]"
            itemSpacing="[0,5]"
            numRows="8"
            drawFocusFeedback="false"/>
    </children>
</component>